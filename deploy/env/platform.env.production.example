# ── PMS Platform (control plane) — PRODUCTION environment ───────────────────
# Copy this to  platform/.env  on the VPS and fill in every blank.
# Never commit the real .env (it is git-ignored).
#
# ⚠ This service is MORE privileged than any hotel: its sessions create,
#   suspend and reconfigure every tenant. Treat these secrets accordingly, and
#   see deploy/nginx/platform.sandhyagrand.in.conf for network-level access
#   control — a password on a public URL should not be the only thing in front
#   of it.

NODE_ENV=production

# Port the control plane listens on (loopback only; nginx proxies to it).
# Must not collide with the hotel API (5002).
PLATFORM_PORT=5100

# ── Database ────────────────────────────────────────────────────────────────
# Same Atlas cluster as the hotel app is fine — the control plane uses its own
# database and imports no hotel schemas.
#   ⚠ Add the VPS public IP to Atlas → Network Access → IP Access List.
MONGODB_URI=

# Database holding the tenant registry + platform admins.
CONTROL_DB_NAME=pms_control

# Database name for the original/first hotel (the "base" tenant).
BASE_DB_NAME=HSG_PMS

# ── Auth ────────────────────────────────────────────────────────────────────
# MUST match the hotel API's JWT_SECRET: tokens are signed with the shared
# secret and separated by their `tenant` / `scope` claims, not by key.
JWT_SECRET=

# Platform-admin session lifetime.
PLATFORM_JWT_EXPIRES_IN=7d

# One-time key required to create the FIRST platform admin. Without it, /setup
# refuses to run in production. Generate something long and random, use it once,
# then remove it from this file:
#   openssl rand -hex 32
PLATFORM_SETUP_KEY=

# ── CORS ────────────────────────────────────────────────────────────────────
# The operator console is served by this same app (same-origin), so this is
# normally left EMPTY in production. Only add an origin if you host the console
# separately. An empty list blocks all cross-origin browser calls.
ALLOWED_ORIGINS=

# Subdomains that may never be assigned to a tenant.
RESERVED_SUBDOMAINS=www,admin,api,platform,app,mail,ftp,ns1,ns2

# ── Rate limiting ───────────────────────────────────────────────────────────
# Defaults are applied automatically; override only if you have a reason.
# Failed sign-ins per window (successful ones are not counted).
PLATFORM_LOGIN_MAX=10
PLATFORM_LOGIN_WINDOW_MS=900000

# First-run bootstrap attempts per window.
PLATFORM_SETUP_MAX=5
PLATFORM_SETUP_WINDOW_MS=3600000

# Ceiling for the rest of the control-plane API.
PLATFORM_API_MAX=300
PLATFORM_API_WINDOW_MS=900000

# Escape hatch for local development ONLY. Never set this in production.
# PLATFORM_DISABLE_RATE_LIMIT=true
