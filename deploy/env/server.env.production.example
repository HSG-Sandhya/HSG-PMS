# ── Sandhya Grand API — PRODUCTION environment ──────────────────────────────
# Copy this to  server/.env  on the VPS and fill in every blank. Most secrets
# already exist in your current dev server/.env — carry the same values over.
# Never commit the real .env (it is git-ignored).

NODE_ENV=production
PORT=5002

# MongoDB Atlas — same connection string you use in dev.
#   ⚠ Add the VPS public IP to Atlas → Network Access → IP Access List,
#     otherwise the server cannot connect.
MONGODB_URI=

# 64+ char random secret. Keep it STABLE across restarts — changing it logs
# every active session out. (Leave ENABLE_JWT_ROTATION unset to avoid that.)
JWT_SECRET=

# CORS allowlist: the public site origin(s) that call this API cross-origin.
# The admin SPA is same-origin so it technically doesn't need listing; included
# for safety. In production an empty/omitted list blocks all browser origins.
ALLOWED_ORIGINS=https://sandhyagrand.in,https://www.sandhyagrand.in,https://admin.sandhyagrand.in

# Behind nginx: trust exactly one proxy hop so req.ip, rate-limiting and the
# HTTPS/secure-cookie detection work correctly.
TRUST_PROXY=1

# API docs (/api/docs) stay OFF in production unless you flip this to true.
# ENABLE_API_DOCS=false

# Uploads live on the VPS disk; the default is relative to server/.
UPLOAD_DIR=uploads

# Log VERBOSITY only: error | warn | info | debug (default: warn in production).
# There is no LOG_DIR — the logger writes to stdout/stderr and PM2 captures it
# to /var/log/sandhya/api-out.log and api-error.log (see deploy/ecosystem.config.cjs).
# A LOG_DIR setting here was read by nothing.
LOG_LEVEL=warn

# ── Carry these over from your existing dev server/.env ─────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
EMAIL_USER=
EMAIL_PASSWORD=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMS_PROVIDER=fast2sms
FAST2SMS_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
SUREPASS_TOKEN=
SUREPASS_BASE_URL=https://kyc-api.surepass.io

# ── Multi-tenancy (hosting more than one hotel) ─────────────────────────────
# Documented in server/MULTI_TENANT.md. A SINGLE-HOTEL deployment can leave all
# of these unset — the app falls back to the base database and behaves exactly
# as it did before tenancy existed. Set them once a second hotel goes live.

# Database holding the tenant registry. MUST match the control plane's
# CONTROL_DB_NAME (deploy/env/platform.env.production.example) or the two will
# read different registries.
# CONTROL_DB_NAME=pms_control

# Comma list of apex domains you serve hotels from. **Set this in production.**
# Anything ending in one of these has its leading label treated as the hotel
# subdomain, so taj.sandhyagrand.in -> tenant "taj".
#
# Left unset, host parsing falls back to a heuristic ("3+ labels means the first
# label is the subdomain"). That is right for sandhyagrand.in but WRONG for
# multi-part TLDs such as .co.uk, where it would read "example" out of
# example.co.uk and look for a tenant that does not exist.
# BASE_DOMAINS=sandhyagrand.in

# Subdomains that are never a hotel; these resolve to the base database.
# Default: www,api,admin,app,static,assets,cdn,mail
# RESERVED_SUBDOMAINS=www,api,admin,app,static,assets,cdn,mail

# How long a host->tenant lookup stays cached, in ms (default 60000). Each
# process caches independently — there is no shared cache — so a tenant change
# takes up to this long to be seen everywhere.
# TENANT_CACHE_TTL_MS=60000

# Fail loudly instead of silently falling back to the base database when a
# request has no tenant context. That fallback is what keeps single-hotel
# deployments working, but it also hides genuinely unscoped queries.
#
# Recommended: TENANCY_STRICT=true on DEVELOPMENT and STAGING, so an unscoped
# query throws where you can see it. Leave it OFF (or unset) in production
# unless you are certain every path is scoped — enabling it on a live server
# turns a silent mis-scope into a hard error for real guests.
# TENANCY_STRICT=false
