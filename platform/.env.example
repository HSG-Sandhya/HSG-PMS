# ── PMS Platform (control plane) ─────────────────────────────────────────────
# Runs separately from any hotel app. Connects to the SAME MongoDB cluster as the
# hotels (one database per hotel), but only manages the control database.

# Same Mongo cluster the hotels use (database-per-tenant lives here).
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority

# Control database holding the tenant registry + platform admins. MUST match the
# hotel app's CONTROL_DB_NAME so both see the same registry.
CONTROL_DB_NAME=pms_control

# The base/original hotel's database name (e.g. Sandhya Grand). Provisioning
# refuses to reuse it so a new hotel can never collide with the base hotel.
BASE_DB_NAME=

# Shared JWT signing secret. It is fine (and simplest) to use the SAME secret as
# the hotel app — platform tokens carry scope:"platform" and are only accepted by
# this app's guard, and hotel apps never check the platform scope.
JWT_SECRET=

# Platform admin session lifetime.
PLATFORM_JWT_EXPIRES_IN=7d

# Required in production to create the FIRST platform admin (sent as x-setup-key).
PLATFORM_SETUP_KEY=

# HTTP port for this control-plane service.
PLATFORM_PORT=5100

# Comma-separated browser origins allowed to call this API in production
# (e.g. https://admin.yourpms.com). Empty in dev = allow all.
ALLOWED_ORIGINS=

NODE_ENV=development

# Rate limiting is ON by default (login, first-run setup, and a general API
# ceiling — see middleware/rateLimit.js). Uncomment ONLY for local work; never
# set this in production.
# PLATFORM_DISABLE_RATE_LIMIT=true
